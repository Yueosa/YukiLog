YUKILOG_LISTEN_ADDR=127.0.0.1:3000
YUKILOG_PUBLIC_ORIGIN=https://blog.yeastar.xin
YUKILOG_MEDIA_DIR=/var/lib/yukilog/media
YUKILOG_SUBSCRIPTION_SECRET=replace-with-at-least-32-random-bytes
YUKILOG_MAIL_ENABLED=false
YUKILOG_SMTP_HOST=smtp.example.com
YUKILOG_SMTP_PORT=587
YUKILOG_SMTP_USERNAME=blog@example.com
YUKILOG_SMTP_PASSWORD=replace-me
YUKILOG_SMTP_FROM="YukiLog <blog@example.com>"
RUST_LOG=yukilog_server=info,tower_http=info
DATABASE_URL=postgresql://yukilog:password@127.0.0.1:5432/yukilog
