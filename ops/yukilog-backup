#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly ENV_FILE="/etc/yukilog/yukilog.env"
readonly BACKUP_ROOT="/var/backups/yukilog"
readonly DATA_ROOT="/var/lib/yukilog"
readonly RELEASE_LINK="/var/www/yukilog/current"

[[ $EUID -eq 0 ]] || { echo "请以 root 运行" >&2; exit 1; }
[[ -r "$ENV_FILE" ]] || { echo "缺少 $ENV_FILE" >&2; exit 1; }

# Generated by YukiLog bootstrap and writable only by root.
# shellcheck disable=SC1090
set -a
source "$ENV_FILE"
set +a
: "${DATABASE_URL:?DATABASE_URL 未配置}"

# Nanoseconds prevent two sequential deployments in the same second from
# selecting the same backup directory.
readonly BACKUP_ID="$(date -u +%Y%m%dT%H%M%SZ-%N)"
readonly STAGE="$BACKUP_ROOT/.${BACKUP_ID}.partial"
readonly FINAL="$BACKUP_ROOT/$BACKUP_ID"

mkdir -p -m 700 "$BACKUP_ROOT"
[[ ! -e "$FINAL" && ! -e "$STAGE" ]] || { echo "备份 ID 已存在" >&2; exit 1; }
mkdir -m 700 "$STAGE"
trap 'rm -rf -- "$STAGE"' EXIT

pg_dump --format=custom --no-owner --no-acl \
    --file="$STAGE/database.dump" "$DATABASE_URL"
tar -C "$DATA_ROOT" -czf "$STAGE/media.tar.gz" media
install -m 600 "$ENV_FILE" "$STAGE/yukilog.env"
if ! readlink -f "$RELEASE_LINK" > "$STAGE/release-path"; then
    printf 'none\n' > "$STAGE/release-path"
fi

(
    cd "$STAGE"
    sha256sum database.dump media.tar.gz yukilog.env release-path > MANIFEST.sha256
)

mv -- "$STAGE" "$FINAL"
trap - EXIT
printf '备份已创建：%s\n' "$FINAL"
