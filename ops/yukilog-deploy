#!/usr/bin/env bash

set -Eeuo pipefail
umask 027

readonly ARCHIVE="${1:-}"
readonly BASE="/var/www/yukilog"
readonly RELEASES="$BASE/releases"
readonly CURRENT="$BASE/current"
readonly ENV_FILE="/etc/yukilog/yukilog.env"
readonly LOCK_FILE="/run/lock/yukilog-deploy.lock"

[[ $EUID -eq 0 ]] || { echo "请以 root 运行" >&2; exit 1; }
[[ -f "$ARCHIVE" ]] || { echo "用法：yukilog-deploy <release.tar.gz>" >&2; exit 2; }
[[ -f "$ARCHIVE.sha256" ]] || { echo "缺少 $ARCHIVE.sha256" >&2; exit 1; }
[[ -r "$ENV_FILE" ]] || { echo "缺少 $ENV_FILE" >&2; exit 1; }

exec 9>"$LOCK_FILE"
flock -n 9 || { echo "另一个 YukiLog 部署正在运行" >&2; exit 1; }

(
    cd "$(dirname "$ARCHIVE")"
    sha256sum --check "$(basename "$ARCHIVE").sha256"
)

while IFS= read -r entry; do
    [[ "$entry" != /* && "$entry" != *"/../"* && "$entry" != "../"* ]] \
        || { echo "发布包包含不安全路径：$entry" >&2; exit 1; }
done < <(tar -tzf "$ARCHIVE")

readonly STAGE="$RELEASES/.incoming-$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir -p -m 755 "$RELEASES"
mkdir -m 755 "$STAGE"
trap 'rm -rf -- "$STAGE"' EXIT
tar -C "$STAGE" -xzf "$ARCHIVE"

readonly VERSION="$(tr -d '\r\n' < "$STAGE/RELEASE")"
[[ "$VERSION" =~ ^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{7,40}$ ]] \
    || { echo "发布版本号无效" >&2; exit 1; }
readonly RELEASE="$RELEASES/$VERSION"
[[ ! -e "$RELEASE" ]] || { echo "版本已经存在：$VERSION" >&2; exit 1; }

(
    cd "$STAGE"
    sha256sum --check MANIFEST.sha256
)
for binary in yukilog-server yukilog-admin yukilog-mailer yukilog-migration; do
    [[ -x "$STAGE/bin/$binary" ]] || { echo "缺少可执行文件：$binary" >&2; exit 1; }
done
[[ -f "$STAGE/admin/index.html" ]] || { echo "缺少管理后台" >&2; exit 1; }
nginx -t

mv -- "$STAGE" "$RELEASE"
trap - EXIT
chown -R root:root "$RELEASE"
chmod -R a-w "$RELEASE"

/usr/local/sbin/yukilog-backup

# Generated by bootstrap and writable only by root.
# shellcheck disable=SC1090
set -a
source "$ENV_FILE"
set +a
: "${DATABASE_URL:?DATABASE_URL 未配置}"

runuser -u yukilog -- env DATABASE_URL="$DATABASE_URL" \
    "$RELEASE/bin/yukilog-migration" up

readonly PREVIOUS="$(readlink -f "$CURRENT" 2>/dev/null || true)"
ln -s "$RELEASE" "$BASE/.current-$VERSION"
mv -Tf "$BASE/.current-$VERSION" "$CURRENT"

rollback_release() {
    if [[ -n "$PREVIOUS" && -d "$PREVIOUS" ]]; then
        ln -s "$PREVIOUS" "$BASE/.rollback-current"
        mv -Tf "$BASE/.rollback-current" "$CURRENT"
        systemctl restart yukilog-server.service
        [[ "${YUKILOG_MAIL_ENABLED:-false}" != "true" ]] \
            || systemctl restart yukilog-mailer.service
        echo "应用切换失败，已恢复上一版本：$PREVIOUS" >&2
    fi
}

systemctl enable yukilog-server.service
systemctl restart yukilog-server.service
if [[ "${YUKILOG_MAIL_ENABLED:-false}" == "true" ]]; then
    : "${YUKILOG_SMTP_HOST:?邮件已启用但 YUKILOG_SMTP_HOST 未配置}"
    systemctl enable yukilog-mailer.service
    systemctl restart yukilog-mailer.service
else
    systemctl disable yukilog-mailer.service 2>/dev/null || true
    systemctl stop yukilog-mailer.service 2>/dev/null || true
fi

healthy=false
for _ in {1..30}; do
    if curl --fail --silent --show-error \
        http://127.0.0.1:3000/health/ready >/dev/null; then
        healthy=true
        break
    fi
    sleep 1
done

if [[ "$healthy" != true ]]; then
    journalctl -u yukilog-server.service --no-pager -n 50 >&2 || true
    rollback_release
    exit 1
fi

systemctl reload nginx
printf 'YukiLog 已切换到 %s\n' "$VERSION"
