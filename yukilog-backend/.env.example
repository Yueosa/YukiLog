# ====================================
# YukiLog Backend 配置示例
# ====================================
# 复制此文件为 .env 并填入实际配置

# ----------------
# 数据库配置
# ----------------
DATABASE_URL=postgresql://username:password@localhost:5432/yukilog

# ----------------
# Redis 配置
# ----------------
# Redis 用于 IP 限流和缓存
# 默认无密码: redis://localhost:6379
# 有密码: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379

# ----------------
# 服务器配置
# ----------------
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# ----------------
# JWT 配置
# ----------------
# 请使用随机生成的强密钥（至少 32 字节）
# 生成命令: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production-use-openssl-rand

# JWT 过期时间（秒）
# 86400 = 24小时
JWT_EXPIRES_IN=86400
JWT_ISSUER=yukilog
JWT_AUDIENCE=yukilog-admin

# ----------------
# 管理员凭据
# ----------------
ADMIN_USERNAME=admin

# 管理员密码哈希 (使用 Argon2)
# 生成方法: cargo run --bin hash_password -- your_password
# 不提供可登录的示例密码，必须替换为上方命令的输出。
ADMIN_PASSWORD_HASH=replace-with-generated-argon2id-hash

# ----------------
# 反向代理与 CORS
# ----------------
# nginx 与后端位于同一台服务器且后端仅监听 127.0.0.1 时可设为 true。
# 设为 false 时会忽略客户端可伪造的 X-Forwarded-For / X-Real-IP。
TRUST_PROXY_HEADERS=true

# 浏览器跨域访问的允许源，多个用逗号分隔。
# 留空表示禁用 CORS（同源访问仍然可用）。
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ----------------
# 日志级别
# ----------------
# trace, debug, info, warn, error
RUST_LOG=info
